# 测试/预发布环境配置
# 打包命令: npm run build:staging

# 应用标题
VITE_APP_TITLE=员工管理系统(测试)

# API接口地址
VITE_API_BASE_URL=https://test-api.example.com

# 是否启用Mock数据
VITE_ENABLE_MOCK=false

# 是否显示调试工具
VITE_SHOW_DEBUG_TOOL=true

# 接口超时时间(ms)
VITE_TIMEOUT=15000

# 是否启用错误日志上报
VITE_ERROR_REPORT=true

# 上报地址
VITE_ERROR_REPORT_URL=https://test-log.example.com/api/error
